# Copy to backend/.env on your machine, or to /opt/apnastorage/.env on the server.
# Do not commit the filled-in file.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=apnastorage
DB_USER=apna_user
DB_PASSWORD=change-me

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# At least 32 characters. Generate a new one for production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MINUTES=1440

SERVER_PORT=8080
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE=25MB
CORS_ALLOWED_ORIGINS=http://localhost:5173
PASSWORD_PBKDF2_ITERATIONS=1500000
SWAGGER_ENABLED=false
